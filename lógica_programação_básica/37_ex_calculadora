"""
Exercício de Calculadora

"""

primeiro_numero = int(input("Digite o primeiro número: "))
segundo_numero = int(input("Digite o segundo número: "))
operador = input("Digite o tipo de Operação Desejada (+, -, *, /): ")

if operador == "+":
    resultado = primeiro_numero + segundo_numero
    print(f"Você escolheu Soma. O resultado é: {resultado}")

elif operador == "-":
    resultado = primeiro_numero - segundo_numero
    print(f"Você escolheu Subtração. O resultado é: {resultado}")

elif operador == "*":
    resultado = primeiro_numero * segundo_numero
    print(f"Você escolheu Multiplicação. O resultado é: {resultado}")

elif operador == "/":
    if segundo_numero != 0:
        resultado = primeiro_numero / segundo_numero
        print(f"Você escolheu Divisão. O resultado é: {resultado}")
    else:
        print("Erro: Divisão por zero não é permitida.")
else:
    print("Operador inválido. Por favor, escolha entre +, -, * ou /.")


while True:
    sair = input("Deseja sair? [s]im / [n]ão: ").lower()

    if sair.startswith("s"):
        print("Encerrando o Programa, até mais")
        break

    elif sair.startswith("n"):
        print("Reiniciando o Programa")
        primeiro_numero = int(input("Digite o primeiro número: "))
        segundo_numero = int(input("Digite o segundo número: "))
        operador = input("Digite o tipo de Operação Desejada (+, -, *, /): ")

        if operador == "+":
            resultado = primeiro_numero + segundo_numero
            print(f"Você escolheu Soma. O resultado é: {resultado}")

        elif operador == "-":
            resultado = primeiro_numero - segundo_numero
            print(f"Você escolheu Subtração. O resultado é: {resultado}")

        elif operador == "*":
            resultado = primeiro_numero * segundo_numero
            print(f"Você escolheu Multiplicação. O resultado é: {resultado}")

        elif operador == "/":
            if segundo_numero != 0:
                resultado = primeiro_numero / segundo_numero
                print(f"Você escolheu Divisão. O resultado é: {resultado}")
            else:
                print("Erro: Divisão por zero não é permitida.")
        else:
            print("Operador inválido. Por favor, escolha entre +, -, * ou /.")